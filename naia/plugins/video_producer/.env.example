# Variáveis do Video Producer. Vão no MESMO arquivo da Naia: /root/.hermes/.env
# (não crie outro .env). Nenhuma chave entra no repositório.

# true = não chama ElevenLabs nem Veo; gera áudio e cenas de teste (sem custo)
VIDEO_PRODUCER_MOCK=true
# true = roteiro e storyboard escritos pelo modelo da Naia (gasta cota do ChatGPT)
VIDEO_PRODUCER_SCRIPT_LLM=true

# Google AI Studio (Veo). Aceita chave nova (AQ.) e antiga (AIza).
GEMINI_API_KEY=
VEO_MODEL=veo-3.1-fast-generate-preview
VEO_RESOLUTION=720p

# ElevenLabs (voz)
ELEVENLABS_API_KEY=
ELEVENLABS_VOICE_ID=
ELEVENLABS_MODEL=eleven_multilingual_v2

# Pastas e binários (vazio = padrão: /root/.hermes/video_producer e ffmpeg do sistema)
VIDEO_OUTPUT_DIR=
FFMPEG_PATH=
FFPROBE_PATH=

# Limites para não gastar em loop
MAX_SCENE_RETRIES=2
MAX_QA_RETRIES=2
MAX_VIDEO_DURATION=90
MIN_VIDEO_DURATION=10
DEFAULT_SCENE_DURATION=6
DEFAULT_VIDEO_DURATION=40
VIDEO_HTTP_TIMEOUT=120
VIDEO_HTTP_MAX_RETRIES=3

# Opcional: sobrescreve a tabela templates/pricing.json
VEO_PRICE_PER_SECOND=
ELEVENLABS_PRICE_PER_1K_CHARS=
