# Modelo do arquivo que vive em /root/.hermes/.env na VPS.
# O arquivo real NUNCA entra no repositorio (ver .gitignore).
# Na VPS ele precisa de permissao 600.

# Token do bot, obtido no @BotFather
TELEGRAM_BOT_TOKEN={{TELEGRAM_BOT_TOKEN}}

# Telegram user ID do dono. So esse ID conversa com ela.
TELEGRAM_ALLOWED_USERS={{DONO_TELEGRAM_ID}}

# Reacao com emoji como confirmacao visual de recebimento
TELEGRAM_REACTIONS=true

# Chave da Maton (acesso ao Google Drive e Workspace). As skills usam
# um nome ou o outro, entao as duas linhas levam a mesma chave.
# Preencher na VPS depois da instalacao (painel da Maton -> API Key).
MATON_API_KEY=
MATON_AI_API_KEY=

# Video Producer (plugin naia/plugins/video_producer). Lista completa e
# explicacao em naia/plugins/video_producer/.env.example.
VIDEO_PRODUCER_MOCK=true
VIDEO_PRODUCER_SCRIPT_LLM=true
GEMINI_API_KEY=
ELEVENLABS_API_KEY=
ELEVENLABS_VOICE_ID=
VEO_MODEL=veo-3.1-fast-generate-preview
