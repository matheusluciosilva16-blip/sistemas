// Configuração do Worker no Cloudflare.
// O database_id aponta para o banco D1 "metricas" da conta do escritório.
{
  "name": "metricas-escritorio",
  "main": "src/index.js",
  "compatibility_date": "2026-09-01",
  "observability": { "enabled": true },
  // Fontes, logo e ícones (os mesmos arquivos das landing pages)
  "assets": { "directory": "./public" },
  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "metricas",
      // Banco criado no painel do Cloudflare em 15/10/2026 (D1 → metricas)
      "database_id": "8c6419cb-e103-4494-b2d7-c91f7478cb76",
      "migrations_dir": "migrations"
    }
  ]
}
