# Cabeçalhos dos arquivos estáticos (fontes e imagens), servidos direto pelo Cloudflare.
# Fontes nunca mudam: o nome do arquivo já carrega peso e subset.
/fontes/*
  Cache-Control: public, max-age=31536000, immutable
  X-Content-Type-Options: nosniff

/img/*
  Cache-Control: public, max-age=604800, must-revalidate
  X-Content-Type-Options: nosniff
